{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // Output settings for npm package
    "outDir": "./dist",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,

    // Enable emit (override base config)
    "noEmit": false,

    // Module settings for npm package
    "module": "ESNext",
    "moduleResolution": "node",
    "target": "ES2020",

    // Don't allow importing .ts extensions in build
    "allowImportingTsExtensions": false,
    "verbatimModuleSyntax": false,

    // JSX settings
    "jsx": "react-jsx",

    // Strict type checking
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "**/*.test.ts",
    "**/*.test.tsx"
  ]
}
